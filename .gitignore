# 忽略vscode的配置文件
.vscode

# 依赖目录
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Docusaurus
docs/node_modules/
docs/.docusaurus/
docs/.cache-loader/

# 环境配置
.env
.env.local
.env.*.local

# 编辑器配置
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 构建输出
dist/
build/
out/

# Docusaurus 构建输出 - 由 GitHub Actions 自动生成
# 本地不需要追踪,远程通过 CI/CD 自动构建
public/newDocs/

# 日志文件
*.log
logs/

# 临时文件
.tmp/
.temp/
.cache/

# 系统文件
Thumbs.db
desktop.ini

# 构建产物 —— 机场在线状态数据
# 由构建流程（npm run check-airports）在部署时生成，不进源码分支，
# 重新构建后部署分支自动同步。本地预览可手动执行该命令生成
public/assets/data/

# WorkBuddy 工作记录（仅本地使用，不进版本库）
.workbuddy/
